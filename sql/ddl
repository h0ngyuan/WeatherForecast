CREATE TABLE FORMAL_WEATHER_DATA (
    ID BIGINT AUTO_INCREMENT PRIMARY KEY COMMENT '主键ID',

    -- 地理与元信息
    LOCATION VARCHAR(50) NOT NULL COMMENT '地区名称，如杭州、成都等',

    -- 时间字段
    TIME DATETIME NOT NULL COMMENT '气象观测时间（UTC或本地时区需统一）',
    CREATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '记录插入数据库时间',
    UPDATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '记录最后更新时间',

    -- 可用性控制
    AVAILABLE TINYINT(1) DEFAULT 1 COMMENT '是否可用：1=可用，0=不可用',

    -- 气象原始字段（按CSV列顺序）
    TEMP DECIMAL(5,2) COMMENT '气温 (°C)',
    RH DECIMAL(5,2) COMMENT '相对湿度 (%)',
    DEW DECIMAL(5,2) COMMENT '露点温度 (°C)',
    PRECIP DECIMAL(6,2) COMMENT '总降水 (mm)',
    RAIN DECIMAL(6,2) COMMENT '降雨量 (mm)',
    SNOW DECIMAL(6,2) COMMENT '降雪量 (mm)',
    APP_TEMP DECIMAL(5,2) COMMENT '体感温度 (°C)',
    WEATHER_CODE INT COMMENT '天气现象代码（WMO标准）',
    P_MSL DECIMAL(7,2) COMMENT '平均海平面气压 (hPa)',
    SURF_P DECIMAL(7,2) COMMENT '地表气压 (hPa)',
    CLOUD DECIMAL(5,2) COMMENT '总云量 (%)',
    WIND10 DECIMAL(5,2) COMMENT '10米风速 (m/s)',
    DIR10 SMALLINT UNSIGNED COMMENT '10米风向 (度)',
    GUST10 DECIMAL(5,2) COMMENT '10米阵风 (m/s)',
    SOIL_T0 DECIMAL(5,2) COMMENT '地表土壤温度 (°C)',
    SNOW_DEPTH DECIMAL(6,2) COMMENT '积雪深度 (cm)',
    CLOUD_LOW DECIMAL(5,2) COMMENT '低云量 (%)',
    CLOUD_MID DECIMAL(5,2) COMMENT '中云量 (%)',
    CLOUD_HIGH DECIMAL(5,2) COMMENT '高云量 (%)',
    ET0 DECIMAL(6,3) COMMENT '参考作物蒸散量 (mm)',
    VPD DECIMAL(6,3) COMMENT '饱和水汽压差 (kPa)',
    WIND100 DECIMAL(5,2) COMMENT '100米风速 (m/s)',
    DIR100 SMALLINT UNSIGNED COMMENT '100米风向 (度)',
    SOIL_T7 DECIMAL(5,2) COMMENT '7cm土壤温度 (°C)',
    SOIL_M0 DECIMAL(5,3) COMMENT '地表土壤湿度 (m³/m³)',
    SOIL_M7 DECIMAL(5,3) COMMENT '7cm土壤湿度 (m³/m³)',

    -- 索引优化
    INDEX IDX_LOCATION_TIME (LOCATION, TIME),
    INDEX IDX_CREATE_TIME (CREATE_TIME),
    INDEX IDX_AVAILABLE (AVAILABLE)
) ENGINE=InnoDB AUTO_INCREMENT = 100000 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='正式气象数据表';


CREATE TABLE SYS_PARAM_DICT (
    ID BIGINT AUTO_INCREMENT PRIMARY KEY COMMENT '主键ID',

    -- 字典类型标识（允许为空）
    DICT_TYPE_ID INT NULL COMMENT '字典类型ID，如 1=天气代码，2=风向等',

    -- 字典分类标识（允许为空）
    DICT_TYPE VARCHAR(50) NULL COMMENT '字典类型编码，如 weather_code',
    DICT_TYPE_NAME VARCHAR(100) NULL COMMENT '字典类型名称，如 "WMO天气代码"',

    -- 具体项（仍保持非空，因无 key/value 则无意义）
    DICT_KEY VARCHAR(50) NOT NULL COMMENT '字典项的键（code值，如 "0", "51"）',
    DICT_VALUE VARCHAR(255) NOT NULL COMMENT '字典项的值（描述，如 "晴天"）',

    -- 扩展字段
    DESCRIPTION TEXT COMMENT '详细说明',
    SORT_ORDER INT DEFAULT 0 COMMENT '排序权重',

    -- 管理字段
    AVAILABLE TINYINT(1) DEFAULT 1 COMMENT '是否启用：1=可用，0=禁用',
    CREATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP,
    UPDATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    -- 唯一约束：注意，若 DICT_TYPE 可为空，则 (NULL, '0') 与 (NULL, '0') 在 MySQL 中不违反唯一约束
    -- 因此需谨慎。若业务要求“未分类项的 DICT_KEY 也必须唯一”，可考虑其他策略。
    -- UNIQUE KEY UK_TYPE_KEY (DICT_TYPE, DICT_KEY),

    -- 索引
    INDEX IDX_DICT_TYPE_ID (DICT_TYPE_ID),
    INDEX IDX_DICT_TYPE (DICT_TYPE),
    INDEX IDX_AVAILABLE (AVAILABLE)
) ENGINE=InnoDB AUTO_INCREMENT = 100000 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='通用数据字典表（码表）';

CREATE TABLE PREDICTED_TEMP_DATA (
    ID BIGINT AUTO_INCREMENT PRIMARY KEY COMMENT '主键ID',

    LOCATION VARCHAR(50) NOT NULL COMMENT '地区名称，如杭州、成都等',
    TIME DATETIME NOT NULL COMMENT '预测目标时间（UTC或统一时区）',

    TEMP DECIMAL(5,2) NOT NULL COMMENT '预测气温 (°C)',

    SOURCE_TYPE TINYINT(1) DEFAULT 0 COMMENT '数据来源：0=本地模型预测，1=外部API（如气象局），2=人工修正',

    AVAILABLE TINYINT(1) DEFAULT 1 COMMENT '是否可用：1=可用，0=不可用',
    CREATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '记录插入时间',
    UPDATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '记录最后更新时间',

    -- 唯一约束：同一地点+时间只应有一条有效预测（业务层面可覆盖）
    -- UNIQUE KEY UK_LOCATION_TIME (LOCATION, TIME),

    -- 索引优化
    INDEX IDX_LOCATION (LOCATION),
    INDEX IDX_TIME (TIME),
    INDEX IDX_SOURCE_TYPE (SOURCE_TYPE),
    INDEX IDX_AVAILABLE (AVAILABLE)
) ENGINE=InnoDB AUTO_INCREMENT = 100000 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='预测气温数据表';

CREATE TABLE PREDICTED_WEATHER_CODE_DATA (
    ID BIGINT AUTO_INCREMENT PRIMARY KEY COMMENT '主键ID',

    LOCATION VARCHAR(50) NOT NULL COMMENT '地区名称，如杭州、成都等',
    TIME DATETIME NOT NULL COMMENT '预测目标时间（UTC或统一时区）',

    WEATHER_CODE INT NOT NULL COMMENT '预测天气现象代码（WMO标准）',

    WEATHER_CODE_VALUE VARCHAR(50) NULL COMMENT '预测天气现象代码值'

    SOURCE_TYPE TINYINT(1) DEFAULT 0 COMMENT '数据来源：0=本地模型预测，1=外部API，2=人工修正',

    AVAILABLE TINYINT(1) DEFAULT 1 COMMENT '是否可用：1=可用，0=不可用',
    CREATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '记录插入时间',
    UPDATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '记录最后更新时间',

    -- 唯一约束
    -- UNIQUE KEY UK_LOCATION_TIME (LOCATION, TIME),

    -- 索引优化
    INDEX IDX_LOCATION (LOCATION),
    INDEX IDX_TIME (TIME),
    INDEX IDX_WEATHER_CODE (WEATHER_CODE),
    INDEX IDX_SOURCE_TYPE (SOURCE_TYPE),
    INDEX IDX_AVAILABLE (AVAILABLE)
) ENGINE=InnoDB AUTO_INCREMENT = 100000 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='预测天气现象数据表';

CREATE TABLE USER_INFO (
    ID BIGINT AUTO_INCREMENT PRIMARY KEY COMMENT '用户ID，从100000开始',

    -- 身份标识
    PHONE VARCHAR(20) NULL COMMENT '手机号（可选）',
    EMAIL VARCHAR(100) NULL COMMENT '邮箱（可选）',
    WECHAT_OPENID VARCHAR(64) NULL COMMENT '微信唯一标识（如 openid 或 unionid）',
    PASSWORD VARCHAR(128) NULL COMMENT '密码(可选)',

    -- 账户信息
    NICKNAME VARCHAR(50) NULL COMMENT '用户昵称',
    AVATAR_URL VARCHAR(255) NULL COMMENT '头像URL',

    -- 来源与身份
    ACCOUNT_SOURCE TINYINT(1) NOT NULL DEFAULT 0 COMMENT '账户来源：0=本地注册，1=微信，2=其他第三方',
    ROLE VARCHAR(30) NOT NULL DEFAULT 'USER' COMMENT '用户角色，如 USER / ADMIN',

    -- 注册信息
    REGISTER_LOCATION VARCHAR(100) NULL COMMENT '注册时地理位置（如 IP 解析的城市）',

    -- 状态与时间
    AVAILABLE TINYINT(1) DEFAULT 1 COMMENT '是否可用：1=正常，0=禁用/注销',
    CREATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP,
    UPDATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    -- 唯一约束（根据业务选择）
    -- UNIQUE KEY UK_PHONE (PHONE),
    -- UNIQUE KEY UK_EMAIL (EMAIL),
    -- UNIQUE KEY UK_WECHAT (WECHAT_OPENID),

    -- 索引
    INDEX IDX_ACCOUNT_SOURCE (ACCOUNT_SOURCE),
    INDEX IDX_AVAILABLE (AVAILABLE)
) ENGINE=InnoDB
  AUTO_INCREMENT = 100000
  DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
  COMMENT='用户信息主表';


CREATE TABLE USER_OPERATION_LOG (
    ID BIGINT AUTO_INCREMENT PRIMARY KEY COMMENT '日志ID，从100000开始',

    USER_ID BIGINT NOT NULL COMMENT '关联 USER_INFO.ID',

    -- 操作上下文
    OPERATION_TYPE VARCHAR(50) NOT NULL COMMENT '操作类型，如 LOGIN / SEND_MESSAGE / PREDICT_REQUEST',
    OPERATION_DESC VARCHAR(255) NULL COMMENT '操作描述（可选）',

    -- 客户端信息
    CLIENT_IP VARCHAR(45) NOT NULL COMMENT '客户端IP（支持IPv6）',
    LOCATION VARCHAR(100) NULL COMMENT 'IP解析的地理位置（如 杭州市）',

    -- 请求与响应
    REQUEST_PARAMS JSON NULL COMMENT '请求参数（结构化存储，如 {"target_time": "2026-01-18T12:00:00"}）',
    RESPONSE_RESULT JSON NULL COMMENT '返回结果（如 {"weather_code": 1, "temp": 15.2}）',

    -- 时间
    CREATE_TIME DATETIME DEFAULT CURRENT_TIMESTAMP,

    -- 索引
    INDEX IDX_USER_ID (USER_ID),
    INDEX IDX_OPERATION_TYPE (OPERATION_TYPE),
    INDEX IDX_CREATE_TIME (CREATE_TIME),
    INDEX IDX_CLIENT_IP (CLIENT_IP)
) ENGINE=InnoDB
  AUTO_INCREMENT = 100000
  DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
  COMMENT='用户操作日志表';